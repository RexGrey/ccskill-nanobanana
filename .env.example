# Nano Banana Pro — multi-channel credentials
# ============================================
# At least ONE of the three channels below must be configured.
# The script tries providers in order; see --provider flag for overrides.

# --- Channel 1: AI Studio (cheapest, simplest) ---
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-ai-studio-api-key

# Optional: extra keys for load balancing (comma-separated)
# GEMINI_API_KEYS=key1,key2,key3


# --- Channel 2: Vertex AI Service Account (billing-independent fallback) ---
# Create SA at https://console.cloud.google.com/iam-admin/serviceaccounts
# Grant "Vertex AI User" role, download JSON key
# VERTEX_SA_JSON_PATH=/absolute/path/to/service-account.json
# VERTEX_PROJECT_ID=your-gcp-project  # optional, auto-read from SA JSON


# --- Channel 3: 柏拉图 (bltcy.ai) middleman (ultimate safety net) ---
# Buy credits at https://bltcy.ai
# BLTCY_API_KEY=sk-your-bltcy-key
# BLTCY_BASE_URL=https://api.bltcy.ai  # default


# --- Credential source override ---
# If you already use ComfyUI-Custom-Batchbox, point to its secrets.yaml
# and this skill will reuse the same credentials automatically:
# CCSKILL_SECRETS_YAML=/absolute/path/to/ComfyUI-Custom-Batchbox/secrets.yaml
